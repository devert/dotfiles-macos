{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "monokai-pro",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "verbosity": "low"
  },
  "animations": true,
  "keybinds": {
    "session.line.up": "ctrl+k,ctrl+alt+y",
    "session.line.down": "ctrl+j,ctrl+alt+e",
    "session.half.page.up": "alt+k,ctrl+alt+u",
    "session.half.page.down": "alt+j,ctrl+alt+d",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.delete.to.line.end": "none"
  },
  "tabs": {
    "layout": "horizontal",
    "indicators": "status"
  }
}
