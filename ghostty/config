# Font
font-family = Operator Mono
font-style = Light
font-style-italic = Light Italic
font-style-bold = Medium
font-style-bold-italic = Medium Italic
font-synthetic-style = false
font-size = 17
font-thicken = true
adjust-cell-height = 2

# Window
# window-colorspace = srgb
window-inherit-working-directory = true
window-padding-x = 10
window-padding-y = 10
resize-overlay = never
unfocused-split-opacity = 0.4
maximize = true

# Behavior
confirm-close-surface = false

# Theme
theme = Monokai Pro

# Keybindings
keybind = global:shift+ctrl+opt+cmd+u=toggle_quick_terminal
keybind = opt+j=resize_split:up,10
keybind = opt+k=resize_split:down,10
keybind = opt+h=resize_split:left,10
keybind = opt+l=resize_split:right,10
keybind = opt+space=equalize_splits
keybind = shift+enter=text:\x1b\r

# Send Ctrl+L (clear) instead of full reset
keybind = cmd+k=unbind
keybind = cmd+k=text:\x0c
